{
  "name": "swapbuds-backend",
  "version": "1.4.0",
  "description": "SWAPBUDS Backend API - NestJS REST API for trading platform",
  "author": "BereDarius",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nodemon",
    "dev:basic": "nest start --watch",
    "start:dev": "nodemon",
    "start:debug": "nest start --debug --watch --watchAssets",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migrate:dev": "prisma migrate dev && npx ts-node scripts/post-migrate.ts",
    "migrate:rollback": "npx ts-node scripts/migrate-rollback.ts",
    "migrate:rollback:last": "npx ts-node scripts/migrate-rollback.ts --last",
    "migrate:rollback:list": "npx ts-node scripts/migrate-rollback.ts --list",
    "migrate:gen-rollback": "npx ts-node scripts/generate-rollback.ts",
    "migrate:gen-rollback:all": "npx ts-node scripts/generate-rollback.ts --missing"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.1.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.9",
    "@prisma/client": "7.1.0",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.4",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.7",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cloudinary": "^2.8.0",
    "compression": "^1.8.1",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jws": "4.0.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.11",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@golevelup/ts-jest": "^0.7.0",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@nestjs/cli": "11.0.14",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "25.0.2",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "7.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^30.2.0",
    "nest-winston": "^1.10.2",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "prisma": "7.1.0",
    "prisma-erd-generator": "^2.4.2",
    "socket.io-client": "^4.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "winston": "^3.19.0"
  },
  "jest": {
    "coverageProvider": "v8",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/scripts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.ts",
      "!**/*.dto.ts",
      "!**/main.ts",
      "!**/config/configuration.ts",
      "!**/prisma/prisma.service.ts",
      "!**/auth/guards/**",
      "!**/auth/strategies/**",
      "!**/auth/decorators/**",
      "!**/test/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    }
  },
  "resolutions": {
    "wrap-ansi": "^7.0.0",
    "string-width": "^4.2.3",
    "glob": "^10.5.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
