# Database
DATABASE_URL="postgresql://swapbuds_dev:swapbuds_dev_password@localhost:5432/swapbuds_dev"

# JWT
JWT_SECRET="your_super_secret_jwt_key_change_in_production_min_32_chars"
JWT_EXPIRATION="24h"

# Cloudinary (Get credentials from https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Redis
REDIS_URL="redis://localhost:6379"

# Application
NODE_ENV="development"
PORT=3001

# Frontend
FRONTEND_URL="http://localhost:3000"

# Trade Expiration
# Trade expiration time in hours (default: 72 = 3 days)
TRADE_EXPIRATION_HOURS=72
# Send notification X hours before expiration (default: 24)
TRADE_EXPIRATION_NOTIFICATION_HOURS=24

# Email (Optional - for email notifications)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER="your-email@gmail.com"
MAIL_PASSWORD="your-app-password"
MAIL_FROM="noreply@swapbuds.com"

# reCAPTCHA v3 (Bot Protection)
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key-from-google"
RECAPTCHA_VERIFY_URL="https://www.google.com/recaptcha/api/siteverify"
RECAPTCHA_MIN_SCORE=0.5

# Document Encryption (ID Verification)
# Generate a secure 32-byte hex key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOCUMENT_ENCRYPTION_KEY="your-64-character-hex-key-for-document-encryption-change-in-production"
