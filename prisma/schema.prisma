// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Compatible with Prisma 7.1.0
// Note: Database URL is configured via DATABASE_URL environment variable

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["nativeDistinct"]
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../docs/database-erd.md"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER ROLE ENUM
// ============================================
enum UserRole {
  USER // Regular user
  MODERATOR // Can moderate content
  SUPPORT // Can handle support tickets
  ADMIN // Full admin access
}

// ============================================
// USER MODEL
// ============================================
model User {
  id        String  @id @default(cuid())
  email     String  @unique
  username  String  @unique
  password  String // Hashed
  avatarUrl String?
  bio       String?
  location  String?

  // Reputation
  reputationScore Float @default(0)

  // Role & Permissions
  role UserRole @default(USER)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Status
  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  // Email Verification
  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  emailVerificationSentAt  DateTime?

  // Multi-Factor Authentication
  mfaEnabled Boolean    @default(false)
  mfaSecret  MFASecret?

  // GDPR - Account Deletion
  deletionRequestedAt DateTime? // When user requested account deletion
  scheduledDeletionAt DateTime? // When account will be permanently deleted

  // Legal Compliance - Age Verification
  dateOfBirth       DateTime? // User's date of birth for age verification
  selfDeclaredAge18 Boolean   @default(false) // User declared they are 18+
  ageVerifiedAt     DateTime? // When age was verified

  // Legal Compliance - Consent Tracking
  tosAcceptedAt     DateTime? // When Terms of Service were accepted
  tosVersion        String? // Version of TOS accepted
  privacyAcceptedAt DateTime? // When Privacy Policy was accepted
  privacyVersion    String? // Version of Privacy Policy accepted
  cookieConsent     Json? // Cookie consent preferences {essential, functional, analytics, marketing, timestamp}

  // Relations
  legalConsents           LegalConsent[]
  items                   Item[]
  tradesProposed          Trade[]                  @relation("TradeProposer")
  tradesReceived          Trade[]                  @relation("TradeResponder")
  reviewsGiven            Review[]                 @relation("ReviewAuthor")
  reviewsReceived         Review[]                 @relation("ReviewTarget")
  messages                Message[]
  messagesDeleted         Message[]                @relation("MessageDeletions")
  conversationsAsUser1    Conversation[]           @relation("ConversationUser1")
  conversationsAsUser2    Conversation[]           @relation("ConversationUser2")
  notifications           Notification[]
  notificationPreferences NotificationPreferences?
  settings                UserSettings?
  likes                   Like[]
  comments                Comment[]
  commentsDeleted         Comment[]                @relation("CommentDeletions")
  commentLikes            CommentLike[]
  counterOffers           CounterOffer[]
  disputesReported        Dispute[]                @relation("DisputeReporter")
  disputesAgainst         Dispute[]                @relation("DisputeReportedUser")
  disputesAdministered    Dispute[]                @relation("DisputeAdmin")
  verification            UserVerification?        @relation("UserVerification")
  auditLogs               AuditLog[]               @relation("AuditLogPerformedBy")
  flaggedItemsReported    FlaggedItem[]            @relation("FlagReporter")
  flaggedItemsReviewed    FlaggedItem[]            @relation("FlagReviewer")
  flaggedCommentsReported FlaggedComment[]         @relation("CommentFlagReporter")
  flaggedCommentsReviewed FlaggedComment[]         @relation("CommentFlagReviewer")
  supportChatsAsUser      SupportChat[]            @relation("SupportChatUser")
  supportChatsAsAgent     SupportChat[]            @relation("SupportChatAgent")
  supportMessages         SupportMessage[]         @relation("SupportMessageSender")
  oauthAccounts           OAuthAccount[]

  @@index([email])
  @@index([username])
  @@index([createdAt])
  @@index([role])
  @@map("users")
}

// ============================================
// ITEM MODEL
// ============================================
enum ItemCondition {
  NEW
  LIKE_NEW
  EXCELLENT
  GOOD
  FAIR
  POOR
}

enum ItemStatus {
  AVAILABLE
  IN_TRADE
  TRADED
  REMOVED
}

enum ItemCategory {
  ELECTRONICS
  CLOTHING
  BOOKS
  TOYS
  SPORTS
  COLLECTIBLES
  HOME
  OTHER
}

// ============================================
// DELIVERY ENUMS
// ============================================
enum DeliveryMethod {
  PHYSICAL // In-person meetup/exchange
  MAIL // Ship via postal service
}

enum DeliveryScope {
  NATIONAL // Only within item owner's country
  INTERNATIONAL // Worldwide shipping/trades
}

// ============================================
// ITEM MODEL
// ============================================
model Item {
  id          String        @id @default(cuid())
  title       String
  description String
  condition   ItemCondition
  category    ItemCategory
  status      ItemStatus    @default(AVAILABLE)

  // Ownership
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Delivery Options
  deliveryMethods DeliveryMethod[] @default([PHYSICAL, MAIL])
  deliveryScope   DeliveryScope    @default(NATIONAL)

  // Value Information
  estimatedValue Decimal? // Optional estimated value in EUR
  currency       String   @default("EUR")

  // Media
  images ItemImage[]

  // Engagement
  likes     Like[]
  comments  Comment[]
  viewCount Int       @default(0)

  // Trading
  tradesOffered      Trade[]        @relation("TradeItemOffered")
  tradesRequested    Trade[]        @relation("TradeItemRequested")
  tradeItems         TradeItem[]
  counterOffersUsing CounterOffer[]

  // Moderation
  flags FlaggedItem[] @relation("FlaggedItems")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@map("items")
}

// ============================================
// ITEM IMAGE MODEL
// ============================================
model ItemImage {
  id       String @id @default(cuid())
  url      String
  publicId String // Cloudinary public ID
  order    Int    @default(0)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([itemId])
  @@map("item_images")
}

// ============================================
// TRADE MODEL
// ============================================
enum TradeStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
  EXPIRED
}

model Trade {
  id     String      @id @default(cuid())
  status TradeStatus @default(PENDING)

  // Participants
  proposerId String
  proposer   User   @relation("TradeProposer", fields: [proposerId], references: [id], onDelete: Cascade)

  responderId String
  responder   User   @relation("TradeResponder", fields: [responderId], references: [id], onDelete: Cascade)

  // Legacy single-item fields (kept for backward compatibility)
  // These are now optional and will be null for multi-item trades
  itemOfferedId String?
  itemOffered   Item?   @relation("TradeItemOffered", fields: [itemOfferedId], references: [id], onDelete: Cascade)

  itemRequestedId String?
  itemRequested   Item?   @relation("TradeItemRequested", fields: [itemRequestedId], references: [id], onDelete: Cascade)

  // Multi-item trade support
  tradeItems TradeItem[]

  // Delivery Method
  deliveryMethod DeliveryMethod // Agreed delivery method for this trade

  // Additional info
  message String?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  expiresAt   DateTime? // When the trade proposal expires

  // Relations
  conversation  Conversation?
  reviews       Review[]
  counterOffers CounterOffer[]
  disputes      Dispute[]

  @@index([proposerId])
  @@index([responderId])
  @@index([status])
  @@index([createdAt])
  @@map("trades")
}

// ============================================
// TRADE ITEM MODEL (Join table for multi-item trades)
// ============================================
enum TradeItemSide {
  OFFERED // Item offered by proposer
  REQUESTED // Item requested from responder
}

model TradeItem {
  id String @id @default(cuid())

  // Trade this item belongs to
  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  // The item being traded
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Which side of the trade (offered or requested)
  side TradeItemSide

  // Order for display purposes
  order Int @default(0)

  // Timestamps
  createdAt DateTime @default(now())

  @@unique([tradeId, itemId]) // Prevent duplicate items in same trade
  @@index([tradeId])
  @@index([itemId])
  @@map("trade_items")
}

// ============================================
// COUNTER OFFER MODEL
// ============================================
enum CounterOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model CounterOffer {
  id     String             @id @default(cuid())
  status CounterOfferStatus @default(PENDING)

  // Trade this counter-offer belongs to
  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  // Who created the counter-offer (either proposer or responder)
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // Alternative item being offered
  alternativeItemId String
  alternativeItem   Item   @relation(fields: [alternativeItemId], references: [id], onDelete: Cascade)

  // Optional message
  message String?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  @@index([tradeId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@map("counter_offers")
}

// ============================================
// CONVERSATION MODEL
// ============================================
model Conversation {
  id String @id @default(cuid())

  // Participants (only 2 users for direct messaging)
  user1Id String
  user1   User   @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)

  user2Id String
  user2   User   @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  // Optional: Related to a trade
  tradeId String? @unique
  trade   Trade?  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  // Last message info for listing
  lastMessageAt      DateTime?
  lastMessageContent String?
  lastMessageSender  String? // userId of last sender

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  messages Message[]

  @@unique([user1Id, user2Id]) // Prevent duplicate conversations
  @@index([user1Id])
  @@index([user2Id])
  @@index([tradeId])
  @@index([lastMessageAt])
  @@map("conversations")
}

// ============================================
// MESSAGE MODEL
// ============================================
model Message {
  id      String @id @default(cuid())
  content String
  type    String @default("text") // text, image, system

  // Sender
  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Conversation
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Status
  isRead Boolean   @default(false)
  readAt DateTime?

  // Edit tracking
  isEdited Boolean          @default(false)
  editedAt DateTime?
  versions MessageVersion[] // Version history for moderation

  // Soft delete
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedBy     String? // User ID who deleted (original user or moderator)
  deletedByUser User?     @relation("MessageDeletions", fields: [deletedBy], references: [id], onDelete: SetNull)
  deleteReason  String? // For moderator deletions

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([isRead])
  @@index([isDeleted])
  @@map("messages")
}

// ============================================
// MESSAGE VERSION MODEL (Edit History)
// ============================================
model MessageVersion {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  content   String // Previous content
  editedBy  String // User ID who made the edit
  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([createdAt])
  @@map("message_versions")
}

// ============================================
// REVIEW MODEL
// ============================================
model Review {
  id      String  @id @default(cuid())
  rating  Int // 1-5 stars
  comment String?

  // Author
  authorId String
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Target user
  targetId String
  target   User   @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  // Trade context
  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authorId, tradeId]) // One review per user per trade
  @@index([targetId])
  @@index([authorId])
  @@map("reviews")
}

// ============================================
// LIKE MODEL
// ============================================
model Like {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, itemId]) // One like per user per item
  @@index([itemId])
  @@index([userId])
  @@map("likes")
}

// ============================================
// COMMENT MODEL
// ============================================
model Comment {
  id      String @id @default(cuid())
  content String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Reply/threading support
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  // Edit tracking
  isEdited Boolean          @default(false)
  editedAt DateTime?
  versions CommentVersion[] // Version history for moderation

  // Soft delete
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedBy     String? // User ID who deleted (original user or moderator)
  deletedByUser User?     @relation("CommentDeletions", fields: [deletedBy], references: [id], onDelete: SetNull)
  deleteReason  String? // For moderator deletions

  // Relations
  likes CommentLike[]
  flags FlaggedComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("comments")
}

// ============================================
// COMMENT VERSION MODEL (Edit History)
// ============================================
model CommentVersion {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  content   String // Previous content
  editedBy  String // User ID who made the edit
  createdAt DateTime @default(now())

  @@index([commentId])
  @@index([createdAt])
  @@map("comment_versions")
}

// ============================================
// COMMENT LIKE MODEL
// ============================================
model CommentLike {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, commentId]) // One like per user per comment
  @@index([commentId])
  @@index([userId])
  @@map("comment_likes")
}

// ============================================
// NOTIFICATION MODEL
// ============================================
enum NotificationType {
  TRADE_PROPOSAL
  TRADE_ACCEPTED
  TRADE_REJECTED
  TRADE_CANCELLED
  TRADE_COMPLETED
  NEW_MESSAGE
  NEW_COMMENT
  NEW_LIKE
  NEW_REVIEW
  VERIFICATION_SUBMITTED
}

model Notification {
  id      String           @id @default(cuid())
  type    NotificationType
  title   String
  message String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Metadata
  metadata Json? // Flexible field for additional data

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// NOTIFICATION PREFERENCES MODEL
// ============================================
model NotificationPreferences {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Email notifications
  emailTradeProposal  Boolean @default(true)
  emailTradeAccepted  Boolean @default(true)
  emailTradeRejected  Boolean @default(true)
  emailTradeCancelled Boolean @default(true)
  emailNewMessage     Boolean @default(true)
  emailNewComment     Boolean @default(true)
  emailNewLike        Boolean @default(false)
  emailNewReview      Boolean @default(true)

  // Push/In-app notifications
  pushTradeProposal  Boolean @default(true)
  pushTradeAccepted  Boolean @default(true)
  pushTradeRejected  Boolean @default(true)
  pushTradeCancelled Boolean @default(true)
  pushNewMessage     Boolean @default(true)
  pushNewComment     Boolean @default(true)
  pushNewLike        Boolean @default(true)
  pushNewReview      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("notification_preferences")
}

// ============================================
// USER SETTINGS MODEL
// ============================================
enum Theme {
  LIGHT
  DARK
  AUTO
}

enum Language {
  EN // English
  RO // Romanian
}

model UserSettings {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Profile Settings
  displayEmail    Boolean @default(false) // Show email on public profile
  displayLocation Boolean @default(true) // Show location on public profile
  allowMessages   Boolean @default(true) // Allow messages from other users

  // Privacy Settings
  profileVisibility String  @default("PUBLIC") // PUBLIC, FRIENDS_ONLY, PRIVATE
  showTradeHistory  Boolean @default(true) // Show completed trades on profile
  showReviews       Boolean @default(true) // Show reviews on profile
  showStatistics    Boolean @default(true) // Show trade statistics

  // Trade Settings
  autoDeclineExpiredTrades Boolean        @default(true) // Auto-decline when trades expire
  allowCounterOffers       Boolean        @default(true) // Allow others to send counter-offers
  requireTradeMessage      Boolean        @default(false) // Require message with trade proposals
  preferredDeliveryMethod  DeliveryMethod @default(PHYSICAL) // Preferred delivery method for trades

  // Notification Frequency
  emailDigestFrequency String @default("DAILY") // REALTIME, DAILY, WEEKLY, NEVER
  pushDigestFrequency  String @default("REALTIME") // REALTIME, HOURLY, DAILY, NEVER

  // UI Preferences
  theme         Theme    @default(AUTO)
  language      Language @default(EN)
  itemsPerPage  Int      @default(12) // Pagination
  defaultSortBy String   @default("RECENT") // RECENT, POPULAR, PRICE_LOW, PRICE_HIGH
  compactView   Boolean  @default(false) // Compact list view vs card view

  // Search & Discovery
  saveSearchHistory     Boolean @default(true)
  showSimilarItems      Boolean @default(true)
  enableRecommendations Boolean @default(true)

  // Accessibility
  highContrast     Boolean @default(false)
  largeText        Boolean @default(false)
  reduceMotion     Boolean @default(false)
  screenReaderMode Boolean @default(false)

  // Marketing & Communication
  marketingEmails     Boolean @default(false) // Promotional emails
  productUpdates      Boolean @default(true) // Feature announcements
  communityNewsletter Boolean @default(false) // Community highlights

  // Advanced
  twoFactorEnabled Boolean @default(false)
  sessionTimeout   Int     @default(30) // Minutes of inactivity

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_settings")
}

// ============================================
// DISPUTE MODEL
// ============================================
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum DisputeReason {
  ITEM_NOT_AS_DESCRIBED
  ITEM_NOT_RECEIVED
  ITEM_DAMAGED
  COMMUNICATION_ISSUE
  SCAM_ATTEMPT
  OTHER
}

model Dispute {
  id String @id @default(cuid())

  // Trade being disputed
  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  // User who filed the dispute
  reporterId String
  reporter   User   @relation("DisputeReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  // User being disputed against
  reportedUserId String
  reportedUser   User   @relation("DisputeReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  // Dispute details
  reason      DisputeReason
  description String
  status      DisputeStatus @default(OPEN)

  // Admin handling
  adminId    String?
  admin      User?     @relation("DisputeAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  adminNotes String?
  resolution String?
  resolvedAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tradeId])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([createdAt])
  @@map("disputes")
}

// ============================================
// USER VERIFICATION ENUMS
// ============================================
enum VerificationStatus {
  PENDING // Submitted, awaiting review
  APPROVED // Verified and approved
  REJECTED // Rejected due to invalid/poor quality documents
  UNDERAGE // Rejected - user is under 18 years old
  CANCELLED // User cancelled the request
}

enum DocumentType {
  ID_CARD // National ID card
  PASSPORT // Passport
  DRIVERS_LICENSE // Driver's license
}

// ============================================
// USER VERIFICATION MODEL
// ============================================
model UserVerification {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation("UserVerification", fields: [userId], references: [id], onDelete: Cascade)

  status       VerificationStatus @default(PENDING)
  documentType DocumentType // Type of ID document submitted

  // Document storage
  documentUrlFront String // Front of ID document (encrypted Cloudinary URL)
  documentUrlBack  String? // Back of ID document (optional, encrypted Cloudinary URL)
  selfieUrl        String // Live selfie photo for identity verification (encrypted Cloudinary URL)

  // Age verification
  dateOfBirth DateTime? // Extracted from document (manual or OCR)
  isOver18    Boolean? // Calculated from dateOfBirth

  // Review information
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime? // When admin reviewed it
  reviewedBy      String? // Admin/Support user ID who reviewed
  rejectionReason String? // Reason for rejection (shown to user)
  notes           String? // Internal notes for reviewers (not shown to user)

  // Audit trail
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([submittedAt])
  @@map("user_verifications")
}

// ============================================
// AUDIT LOG MODEL
// ============================================
enum AuditAction {
  USER_BAN // User banned
  USER_UNBAN // User unbanned
  USER_SUSPEND // User suspended
  USER_ACTIVATE // User activated
  ITEM_FLAG // Item flagged
  ITEM_APPROVE // Item approved
  ITEM_REMOVE // Item removed
  ROLE_CHANGE // User role changed
  VERIFICATION_APPROVE // Verification approved
  VERIFICATION_REJECT // Verification rejected
  MODERATION_APPROVE // Flagged item approved
  MODERATION_REMOVE // Flagged item removed
  OTHER // Other admin action
}

model AuditLog {
  id String @id @default(cuid())

  // Who performed the action
  performedById String
  performedBy   User   @relation("AuditLogPerformedBy", fields: [performedById], references: [id])

  // What action
  action      AuditAction
  description String // Human-readable description

  // Target details
  targetType String? // e.g., "User", "Item", "Trade"
  targetId   String? // ID of the affected entity

  // Additional context
  metadata  Json? // Additional data (e.g., old/new values)
  ipAddress String? // IP address of admin

  // Timestamps
  createdAt DateTime @default(now())

  @@index([performedById])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// CONTENT MODERATION MODELS
// ============================================
enum FlagReason {
  INAPPROPRIATE // Inappropriate content (offensive, sexual, etc.)
  SPAM // Spam or fake item
  SCAM // Suspected scam or fraud
  DUPLICATE // Duplicate posting
  PROHIBITED // Prohibited items (weapons, drugs, etc.)
  MISLEADING // Misleading description or images
  COPYRIGHT // Copyright violation
  OTHER // Other reason (see description)
}

enum ModerationStatus {
  PENDING // Waiting for moderator review
  APPROVED // Reviewed and approved (flag dismissed)
  REMOVED // Item removed after review
}

model FlaggedItem {
  id String @id @default(cuid())

  // Item being flagged
  itemId String
  item   Item   @relation("FlaggedItems", fields: [itemId], references: [id], onDelete: Cascade)

  // Who flagged it
  reportedById String
  reportedBy   User   @relation("FlagReporter", fields: [reportedById], references: [id], onDelete: Cascade)

  // Flag details
  reason      FlagReason
  description String? // Additional details from reporter

  // Moderation status
  status ModerationStatus @default(PENDING)

  // Review information (for approved or removed items)
  reviewedById String? // Admin/Moderator who reviewed
  reviewedBy   User?     @relation("FlagReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime? // When it was reviewed
  reviewNotes  String? // Admin notes on the decision

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([reportedById])
  @@index([status])
  @@index([reason])
  @@index([createdAt])
  @@map("flagged_items")
}

// ============================================
// FLAGGED COMMENT MODEL
// ============================================
model FlaggedComment {
  id String @id @default(cuid())

  // Comment being flagged
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // Who flagged it
  reportedById String
  reportedBy   User   @relation("CommentFlagReporter", fields: [reportedById], references: [id], onDelete: Cascade)

  // Flag details
  reason      FlagReason
  description String? // Additional details from reporter

  // Moderation status
  status ModerationStatus @default(PENDING)

  // Review information
  reviewedById String? // Admin/Moderator who reviewed
  reviewedBy   User?     @relation("CommentFlagReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime? // When it was reviewed
  reviewNotes  String? // Admin notes on the decision

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commentId])
  @@index([reportedById])
  @@index([status])
  @@index([reason])
  @@index([createdAt])
  @@map("flagged_comments")
}

// ============================================
// RECAPTCHA LOG MODEL (Optional - Analytics)
// ============================================
model RecaptchaLog {
  id        String   @id @default(cuid())
  action    String // register, login, etc.
  score     Float // 0.0 - 1.0
  ip        String? // IP address of the request
  success   Boolean // true if score >= threshold
  timestamp DateTime @default(now())

  @@index([action])
  @@index([score])
  @@index([timestamp])
  @@map("recaptcha_logs")
}

// ============================================
// SUPPORT CHAT MODELS
// ============================================
enum SupportChatStatus {
  WAITING // In queue, waiting for agent
  ACTIVE // Currently chatting with agent
  RESOLVED // Issue resolved, chat ended
  CLOSED // Chat closed without resolution
}

enum SupportPriority {
  LOW // Normal support request
  MEDIUM // Moderate urgency
  HIGH // High priority (verified users, urgent issues)
  CRITICAL // Critical issues requiring immediate attention
}

model SupportChat {
  id String @id @default(cuid())

  // User requesting support
  userId String
  user   User   @relation("SupportChatUser", fields: [userId], references: [id], onDelete: Cascade)

  // Assigned support agent (nullable when in queue)
  agentId String?
  agent   User?   @relation("SupportChatAgent", fields: [agentId], references: [id], onDelete: SetNull)

  // Chat details
  status        SupportChatStatus @default(WAITING)
  priority      SupportPriority   @default(MEDIUM)
  subject       String // Brief description of the issue
  queuePosition Int?              @default(0) // Position in queue (null when active)

  // Messages
  messages SupportMessage[]

  // Timestamps
  createdAt  DateTime  @default(now())
  startedAt  DateTime? // When agent joined
  resolvedAt DateTime? // When chat was resolved
  closedAt   DateTime? // When chat was closed
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([agentId])
  @@index([status])
  @@index([priority])
  @@index([queuePosition])
  @@index([createdAt])
  @@map("support_chats")
}

model SupportMessage {
  id String @id @default(cuid())

  // Chat this message belongs to
  chatId String
  chat   SupportChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  // Sender (can be user or agent)
  senderId String
  sender   User   @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  // Message content
  message  String
  isSystem Boolean @default(false) // System messages (e.g., "Agent joined", "Chat closed")

  // Timestamp
  createdAt DateTime @default(now())

  @@index([chatId])
  @@index([senderId])
  @@index([createdAt])
  @@map("support_messages")
}

// ============================================
// MFA (Multi-Factor Authentication) MODEL
// ============================================
model MFASecret {
  id String @id @default(cuid())

  // User this MFA secret belongs to
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // TOTP Secret (encrypted)
  secret String

  // Backup codes (encrypted, comma-separated)
  backupCodes String?

  // Recovery information
  recoveryEmail String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("mfa_secrets")
}

// ============================================
// OAuth PROVIDER ENUM
// ============================================
enum OAuthProvider {
  GOOGLE
  FACEBOOK
  APPLE
}

// ============================================
// OAuth ACCOUNT MODEL (for Social Login & Account Linking)
// ============================================
model OAuthAccount {
  id String @id @default(cuid())

  // User this OAuth account is linked to
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Provider information
  provider   OAuthProvider
  providerId String // The user's ID from the OAuth provider

  // Provider profile data
  email        String?
  name         String?
  picture      String?
  accessToken  String? // Encrypted
  refreshToken String? // Encrypted
  tokenExpiry  DateTime?

  // Metadata
  profileData Json? // Store additional provider-specific data

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId]) // One account per provider per provider user
  @@index([userId])
  @@index([provider])
  @@map("oauth_accounts")
}

// ============================================
// LEGAL DOCUMENT TYPE ENUM
// ============================================
enum LegalDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  COOKIE_POLICY
  COMMUNITY_GUIDELINES
}

// ============================================
// LEGAL DOCUMENT MODEL (for TOS, Privacy Policy, etc.)
// ============================================
model LegalDocument {
  id      String            @id @default(cuid())
  type    LegalDocumentType
  version String // e.g., "1.0.0", "2.1.0"

  // Content in different languages
  contentEn String @db.Text // English content (Markdown/HTML)
  contentRo String @db.Text // Romanian content (Markdown/HTML)

  // Metadata
  title       String
  summary     String?  @db.Text // Brief summary of changes
  effectiveAt DateTime // When this version becomes effective
  isActive    Boolean  @default(false) // Only one active version per type

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, version]) // Each type can only have one document per version
  @@index([type, isActive])
  @@map("legal_documents")
}

// ============================================
// LEGAL CONSENT MODEL (tracks user acceptances)
// ============================================
model LegalConsent {
  id String @id @default(cuid())

  // User who accepted
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What was accepted
  documentType    LegalDocumentType
  documentVersion String

  // Acceptance details
  acceptedAt DateTime @default(now())
  ipAddress  String? // IP address at time of acceptance
  userAgent  String? // Browser/device info at time of acceptance

  // Additional metadata
  metadata Json? // Any additional context (e.g., source: "registration", "profile_update")

  @@index([userId])
  @@index([documentType])
  @@index([userId, documentType])
  @@map("legal_consents")
}

// ============================================
// WAITLIST MODEL
// ============================================
model Waitlist {
  id    String @id @default(cuid())
  email String @unique

  // Marketing preferences
  notified     Boolean @default(false) // Whether we've sent launch notification
  source       String? // Where they signed up from (e.g., "landing_page", "social_media")
  referralCode String? // Optional referral tracking

  // Metadata
  userAgent String? // Browser/device info
  ipAddress String? // IP at signup

  // Timestamps
  createdAt  DateTime  @default(now())
  notifiedAt DateTime? // When launch email was sent

  @@index([email])
  @@index([createdAt])
  @@index([notified])
  @@map("waitlist")
}
