// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// NOTE: This schema uses Prisma 5.22.0 syntax.
// If VS Code shows an error on line 10 about `url` being deprecated,
// it's a false positive from the Prisma extension using Prisma 7 validation.
// The schema is valid and works correctly with Prisma 5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MODEL
// ============================================
model User {
  id        String  @id @default(cuid())
  email     String  @unique
  username  String  @unique
  password  String // Hashed
  avatarUrl String?
  bio       String?
  location  String?

  // Reputation
  reputationScore Float @default(0)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Status
  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  // Relations
  items                   Item[]
  tradesProposed          Trade[]                  @relation("TradeProposer")
  tradesReceived          Trade[]                  @relation("TradeResponder")
  reviewsGiven            Review[]                 @relation("ReviewAuthor")
  reviewsReceived         Review[]                 @relation("ReviewTarget")
  messages                Message[]
  conversationsAsUser1    Conversation[]           @relation("ConversationUser1")
  conversationsAsUser2    Conversation[]           @relation("ConversationUser2")
  notifications           Notification[]
  notificationPreferences NotificationPreferences?
  likes                   Like[]
  comments                Comment[]
  counterOffers           CounterOffer[]

  @@index([email])
  @@index([username])
  @@index([createdAt])
  @@map("users")
}

// ============================================
// ITEM MODEL
// ============================================
enum ItemCondition {
  NEW
  LIKE_NEW
  EXCELLENT
  GOOD
  FAIR
  POOR
}

enum ItemStatus {
  AVAILABLE
  IN_TRADE
  TRADED
  REMOVED
}

enum ItemCategory {
  ELECTRONICS
  CLOTHING
  BOOKS
  TOYS
  SPORTS
  COLLECTIBLES
  HOME
  OTHER
}

model Item {
  id          String        @id @default(cuid())
  title       String
  description String
  condition   ItemCondition
  category    ItemCategory
  status      ItemStatus    @default(AVAILABLE)

  // Ownership
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Media
  images ItemImage[]

  // Engagement
  likes     Like[]
  comments  Comment[]
  viewCount Int       @default(0)

  // Trading
  tradesOffered      Trade[]        @relation("TradeItemOffered")
  tradesRequested    Trade[]        @relation("TradeItemRequested")
  counterOffersUsing CounterOffer[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@map("items")
}

// ============================================
// ITEM IMAGE MODEL
// ============================================
model ItemImage {
  id       String @id @default(cuid())
  url      String
  publicId String // Cloudinary public ID
  order    Int    @default(0)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([itemId])
  @@map("item_images")
}

// ============================================
// TRADE MODEL
// ============================================
enum TradeStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

model Trade {
  id     String      @id @default(cuid())
  status TradeStatus @default(PENDING)

  // Participants
  proposerId String
  proposer   User   @relation("TradeProposer", fields: [proposerId], references: [id], onDelete: Cascade)

  responderId String
  responder   User   @relation("TradeResponder", fields: [responderId], references: [id], onDelete: Cascade)

  // Items
  itemOfferedId String
  itemOffered   Item   @relation("TradeItemOffered", fields: [itemOfferedId], references: [id], onDelete: Cascade)

  itemRequestedId String
  itemRequested   Item   @relation("TradeItemRequested", fields: [itemRequestedId], references: [id], onDelete: Cascade)

  // Additional info
  message String?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Relations
  conversation  Conversation?
  reviews       Review[]
  counterOffers CounterOffer[]

  @@index([proposerId])
  @@index([responderId])
  @@index([status])
  @@index([createdAt])
  @@map("trades")
}

// ============================================
// COUNTER OFFER MODEL
// ============================================
enum CounterOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model CounterOffer {
  id     String             @id @default(cuid())
  status CounterOfferStatus @default(PENDING)

  // Trade this counter-offer belongs to
  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  // Who created the counter-offer (either proposer or responder)
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // Alternative item being offered
  alternativeItemId String
  alternativeItem   Item   @relation(fields: [alternativeItemId], references: [id], onDelete: Cascade)

  // Optional message
  message String?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  @@index([tradeId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@map("counter_offers")
}

// ============================================
// CONVERSATION MODEL
// ============================================
model Conversation {
  id String @id @default(cuid())

  // Participants (only 2 users for direct messaging)
  user1Id String
  user1   User   @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)

  user2Id String
  user2   User   @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  // Optional: Related to a trade
  tradeId String? @unique
  trade   Trade?  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  // Last message info for listing
  lastMessageAt      DateTime?
  lastMessageContent String?
  lastMessageSender  String? // userId of last sender

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  messages Message[]

  @@unique([user1Id, user2Id]) // Prevent duplicate conversations
  @@index([user1Id])
  @@index([user2Id])
  @@index([tradeId])
  @@index([lastMessageAt])
  @@map("conversations")
}

// ============================================
// MESSAGE MODEL
// ============================================
model Message {
  id      String @id @default(cuid())
  content String
  type    String @default("text") // text, image, system

  // Sender
  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Conversation
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Status
  isRead Boolean   @default(false)
  readAt DateTime?

  // Soft delete
  isDeleted Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([isRead])
  @@map("messages")
}

// ============================================
// REVIEW MODEL
// ============================================
model Review {
  id      String  @id @default(cuid())
  rating  Int // 1-5 stars
  comment String?

  // Author
  authorId String
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Target user
  targetId String
  target   User   @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  // Trade context
  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authorId, tradeId]) // One review per user per trade
  @@index([targetId])
  @@index([authorId])
  @@map("reviews")
}

// ============================================
// LIKE MODEL
// ============================================
model Like {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, itemId]) // One like per user per item
  @@index([itemId])
  @@index([userId])
  @@map("likes")
}

// ============================================
// COMMENT MODEL
// ============================================
model Comment {
  id      String @id @default(cuid())
  content String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([userId])
  @@index([createdAt])
  @@map("comments")
}

// ============================================
// NOTIFICATION MODEL
// ============================================
enum NotificationType {
  TRADE_PROPOSAL
  TRADE_ACCEPTED
  TRADE_REJECTED
  TRADE_CANCELLED
  TRADE_COMPLETED
  NEW_MESSAGE
  NEW_COMMENT
  NEW_LIKE
  NEW_REVIEW
}

model Notification {
  id      String           @id @default(cuid())
  type    NotificationType
  title   String
  message String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Metadata
  metadata Json? // Flexible field for additional data

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// NOTIFICATION PREFERENCES MODEL
// ============================================
model NotificationPreferences {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Email notifications
  emailTradeProposal  Boolean @default(true)
  emailTradeAccepted  Boolean @default(true)
  emailTradeRejected  Boolean @default(true)
  emailTradeCancelled Boolean @default(true)
  emailNewMessage     Boolean @default(true)
  emailNewComment     Boolean @default(true)
  emailNewLike        Boolean @default(false)
  emailNewReview      Boolean @default(true)

  // Push/In-app notifications
  pushTradeProposal  Boolean @default(true)
  pushTradeAccepted  Boolean @default(true)
  pushTradeRejected  Boolean @default(true)
  pushTradeCancelled Boolean @default(true)
  pushNewMessage     Boolean @default(true)
  pushNewComment     Boolean @default(true)
  pushNewLike        Boolean @default(true)
  pushNewReview      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("notification_preferences")
}
